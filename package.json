{
    "name": "express",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "scripts": {
        "start": "vercel dev",
        "deploy": "vercel deploy",
        "seed": "tsx --env-file=.env.local src/scripts/seed.ts",
        "migration:generate": "tsx --env-file=.env.local node_modules/typeorm/cli.js migration:generate -d src/config/database.ts src/migrations/migration",
        "migration:run": "tsx --env-file=.env.local node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
        "migration:revert": "tsx --env-file=.env.local node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
        "migration:show": "tsx --env-file=.env.local node_modules/typeorm/cli.js migration:show -d src/config/database.ts"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "bcryptjs": "^3.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.7.4",
        "cors": "^2.8.6",
        "express": "^4.18.2",
        "express-rate-limit": "^8.6.2",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.0",
        "uuid": "^10.0.0",
        "vercel": "^59.3.0",
        "winston": "^3.13.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/uuid": "^10.0.0",
        "eslint": "^8.57.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    }
}
